{
  "$schema": "https://opencode.ai/config.json",

  // Default to the free model for all hackathon work.
  "model": "opencode/deepseek-v4.1-flash-free",

  // Shared guardrails. Shell asks by default; routine reads are pre-approved.
  // The last matching rule wins, so specific allow/ask/deny rules go last.
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },

    // Read-only inspection: no prompt.
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },

    // Staging is allowed: the agent prepares the commit for the developer to review.
    { "action": "shell", "resource": "git add *", "effect": "allow" },

    // Anything that can overwrite or delete must always ask.
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "mv *", "effect": "ask" },
    { "action": "shell", "resource": "cp *", "effect": "ask" },
    { "action": "shell", "resource": "sed -i *", "effect": "ask" },
    { "action": "shell", "resource": "truncate *", "effect": "ask" },
    { "action": "shell", "resource": "dd *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout *", "effect": "ask" },
    { "action": "shell", "resource": "git restore *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git reset *", "effect": "ask" },
    { "action": "shell", "resource": "*>*", "effect": "ask" },

    // Hard blocks: the developer commits and pushes, not the agent.
    { "action": "shell", "resource": "git add *.env*", "effect": "deny" },
    { "action": "shell", "resource": "git commit *", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" }
  ],

  // Backup provider. Only used if the free model is rate-limited.
  // The organisers provide HF_TOKEN; never commit it.
  "providers": {
    // Run the free model with the full 200k context and 200k output budget.
    "opencode": {
      "models": {
        "deepseek-v4.1-flash-free": {
          "limit": {
            "context": 200000,
            "output": 200000
          }
        }
      }
    },

    "huggingface": {
      "name": "Hugging Face (backup)",
      "env": ["HF_TOKEN"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://router.huggingface.co/v1"
      },
      "models": {
        "deepseek-v4.1-flash": {
          // Match this to the exact model ID on its Hugging Face page.
          "modelID": "deepseek-ai/DeepSeek-V4.1-Flash",
          "name": "DeepSeek V4.1 Flash (HF)",
          "limit": {
            "context": 200000,
            "output": 200000
          }
        }
      }
    }
  }
}
